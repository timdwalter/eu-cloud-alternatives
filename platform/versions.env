# Pinned versions – single source for deploy scripts and local compose.
# Looked up on the official release pages / registries on 2026-11-26.
# The Node base image is pinned directly in app/*/Dockerfile (same version as below).

NODE_IMAGE=node:26.13.1-alpine
POSTGRES_IMAGE=postgres:17.9-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2

# Helm charts
ENVOY_GATEWAY_CHART=oci://docker.io/envoyproxy/gateway-helm
ENVOY_GATEWAY_VERSION=v1.10.0
CERT_MANAGER_CHART=oci://quay.io/jetstack/charts/cert-manager
CERT_MANAGER_VERSION=v1.21.3
