# Copy to platform/config.local.env (gitignored) and fill in.

# Your domain: the app runs on the apex, Keycloak on auth.<domain>
DOMAIN=example.com
APP_NAME="Text Library"
REALM_NAME=textlib
CLIENT_ID=textlib-web

# letsencrypt-staging first, letsencrypt-prod once the staging certificate works
TLS_ISSUER=letsencrypt-staging
# Optional ACME account e-mail
ACME_EMAIL=

# Image tag to deploy (git SHA pushed by the pipeline or by hand)
IMAGE_TAG=change-me

# Editor account created in Keycloak by deploy.sh
EDITOR_USERNAME=editor
EDITOR_PASSWORD=change-me
