# Copy to local/.env and replace every "change-me". local/.env is gitignored.
# Generate random values e.g. with: openssl rand -hex 32

# Shown in the page header
APP_NAME="Text Library"

# Local PostgreSQL (also used by Keycloak)
POSTGRES_USER=textlib
POSTGRES_PASSWORD=change-me

# Keycloak bootstrap admin (master realm)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me

# Realm and OIDC client of the app
REALM_NAME=textlib
CLIENT_ID=textlib-web
CLIENT_SECRET=change-me

# Session encryption for the frontend (openssl rand -base64 32)
AUTH_SECRET=change-me

# Users created by local/create-users.sh
EDITOR_USERNAME=editor
EDITOR_PASSWORD=change-me
READER_USERNAME=reader
READER_PASSWORD=change-me
