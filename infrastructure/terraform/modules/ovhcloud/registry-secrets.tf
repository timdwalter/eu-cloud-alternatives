data "ovh_cloud_project_capabilities_containerregistry_filter" "small" {
  service_name = var.project_id
  plan_name    = "SMALL"
  region       = var.registry_region
}

# Managed Private Registry (Harbor), smallest plan
resource "ovh_cloud_project_containerregistry" "this" {
  service_name = var.project_id
  name         = "${local.name}-registry"
  region       = var.registry_region
  plan_id      = data.ovh_cloud_project_capabilities_containerregistry_filter.small.id
}

# No keyless pull and no OIDC for CI: two Harbor users, passwords generated by OVHcloud and kept in the
# local state only. Their role/scope cannot be set through the Terraform provider (finding).
resource "ovh_cloud_project_containerregistry_user" "pull" {
  service_name = var.project_id
  registry_id  = ovh_cloud_project_containerregistry.this.id
  login        = "cluster-pull"
  email        = var.registry_user_email
}

resource "ovh_cloud_project_containerregistry_user" "ci" {
  service_name = var.project_id
  registry_id  = ovh_cloud_project_containerregistry.this.id
  login        = "ci-push"
  email        = var.registry_user_email
}

# Secret Manager: the DB password goes into the managed store (like Key Vault on Azure).
resource "ovh_okms_secret" "db_password" {
  okms_id = var.okms_id
  path    = "${local.name}/db-password"

  version = {
    data = jsonencode({ password = ovh_cloud_project_database_postgresql_user.app.password })
  }
}
