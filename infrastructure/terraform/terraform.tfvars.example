# Copy to infrastructure/terraform/terraform.tfvars (gitignored) and fill in.
# Credentials: OVH_CLIENT_ID / OVH_CLIENT_SECRET of the service account textlib-terraform (never in Git).

# ovhcloud cloud project list
project_id = "0123456789abcdef0123456789abcdef"

# Secret Manager created once in the console (ovhcloud okms list)
okms_id = "00000000-0000-0000-0000-000000000000"

# The registry requires an e-mail address for its users
registry_user_email = "you@example.com"

# Optional overrides
# region             = "DE1"
# db_region          = "DE"
# registry_region    = "DE"
# kubernetes_version = "1.34"
# node_flavor        = "d2-4"
# node_count         = 2
